---
import AdminShell from '../../../components/AdminShell.astro';
import { LISTING_STATUSES, setConfirmedWithDoctor, setDoctorArs, setListingStatus, updateDoctor, type DoctorEdit } from '../../../lib/admin-db.ts';
import { adminCanWrite, withDb } from '../../../lib/admin-run.ts';
import { allDoctors, getArs, getSpecialties } from '../../../lib/data.ts';
import { getDataset } from '../../../lib/dataset.ts';

const id = Number(Astro.params.id);
if (!allDoctors().some((d) => d.id === id)) return new Response('Not found', { status: 404 });
let message = ''; let error = false;
if (Astro.request.method === 'POST' && adminCanWrite()) {
  const f = await Astro.request.formData();
  const doc0 = allDoctors().find((d) => d.id === id)!;
  const str = (k: string) => { const v = String(f.get(k) ?? '').trim(); return v === '' ? null : v; };
  const num = (k: string) => { const v = str(k); return v == null ? null : Number(v); };
  const edit: DoctorEdit = {
    slug: String(f.get('slug') ?? doc0.slug), display_name: String(f.get('display_name') ?? doc0.display_name), bio: str('bio'),
    consultation_fee_min: num('fee_min'), consultation_fee_max: num('fee_max'),
    accepting_new_patients: f.get('accepting') === 'unknown' ? null : f.get('accepting') === 'yes',
    whatsapp: str('whatsapp'), phone: str('phone'), website: str('website'), photo_url: str('photo_url'),
    languages: String(f.get('languages') ?? '').split(',').map((l) => l.trim()).filter(Boolean),
  };
  try {
    await withDb(async (run) => {
      await updateDoctor(run, id, edit);
      await setDoctorArs(run, id, f.getAll('ars').map(Number));
      await setConfirmedWithDoctor(run, id, f.get('confirmed') === 'on');
      await setListingStatus(run, id, String(f.get('listing_status') ?? doc0.listing_status));
    }, { reload: true, tx: true });
    message = 'Guardado. Si cambiaste el slug, se creó una redirección 301 automática.';
  } catch (e) { message = `Error: ${(e as Error).message}`; error = true; }
}
const d = allDoctors().find((x) => x.id === id)!;
const myArs = new Set(getDataset().doctorArs.filter((a) => a.doctor_id === id).map((a) => a.ars_id));
const specName = getSpecialties().find((s) => s.id === d.specialty_id)?.name_singular;
---
<AdminShell title={d.display_name} message={message} error={error}>
  <p><small>{specName} · exequátur: {d.exequatur_verified_at ?? 'sin verificar'} · {d.exequatur_verified_at ? <a href={`/${d.slug}`}>ver perfil público</a> : <a href="/admin/verify">verificar</a>}</small></p>
  <form method="post"><fieldset disabled={!adminCanWrite()} style="border:0;padding:0">
    <div class="grid2">
      <div><label for="slug">Slug (URL)</label><input id="slug" name="slug" value={d.slug} pattern="[a-z0-9]+(-[a-z0-9]+)*" /></div>
      <div><label for="dn">Nombre público</label><input id="dn" name="display_name" value={d.display_name} /></div>
      <div><label for="fmin">Consulta desde (DOP)</label><input id="fmin" name="fee_min" type="number" min="0" value={d.consultation_fee_min ?? ''} /></div>
      <div><label for="fmax">Consulta hasta (DOP)</label><input id="fmax" name="fee_max" type="number" min="0" value={d.consultation_fee_max ?? ''} /></div>
      <div><label for="acc">Acepta nuevos pacientes</label><select id="acc" name="accepting"><option value="yes" selected={d.accepting_new_patients === true}>Sí</option><option value="no" selected={d.accepting_new_patients === false}>No</option><option value="unknown" selected={d.accepting_new_patients == null}>Desconocido</option></select></div>
      <div><label for="lang">Idiomas (códigos separados por coma)</label><input id="lang" name="languages" value={d.languages.join(', ')} /></div>
      <div><label for="wa">WhatsApp</label><input id="wa" name="whatsapp" value={d.whatsapp ?? ''} /></div>
      <div><label for="ph">Teléfono</label><input id="ph" name="phone" value={d.phone ?? ''} /></div>
      <div><label for="web">Sitio web</label><input id="web" name="website" value={d.website ?? ''} /></div>
      <div><label for="photo">Foto (URL) — solo se muestra a médicos verificados</label><input id="photo" name="photo_url" value={d.photo_url ?? ''} /></div>
    </div>
    <label for="bio">Biografía</label><textarea id="bio" name="bio" rows="4">{d.bio ?? ''}</textarea>
    <label>ARS que acepta</label>
    <div style="display:flex;flex-wrap:wrap;gap:6px 16px">{getArs().map((a) => <label style="font-weight:400;margin:0"><input type="checkbox" name="ars" value={a.id} checked={myArs.has(a.id)} /> {a.name}</label>)}</div>
    <div class="grid2">
      <div><label for="ls">Estado de la ficha</label>
        <select id="ls" name="listing_status">{LISTING_STATUSES.map((st) => <option value={st} selected={d.listing_status === st}>{{ draft: 'Borrador (oculto)', listed: 'Listado (perfil informativo, sin verificar)', affiliated: 'Verificado (afiliado)' }[st]}</option>)}</select>
        <small>Verificado exige el exequátur comprobado. Solo los verificados muestran foto y aparecen primero.</small></div>
      {d.source_name && <div><label>Fuente de los datos</label><p style="margin:6px 0">{d.source_url ? <a href={d.source_url} rel="noopener nofollow" target="_blank">{d.source_name}</a> : d.source_name}{d.source_retrieved_at ? ` · consultada el ${d.source_retrieved_at}` : ''}</p></div>}
    </div>
    <p><label style="font-weight:400"><input type="checkbox" name="confirmed" checked={d.claimed} /> <b>Confirmado directamente con el médico</b> — el perfil se indexa aunque tenga menos de 3 datos.</label></p>
    <p><button type="submit">Guardar</button></p>
  </fieldset></form>
</AdminShell>
