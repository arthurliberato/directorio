---
import Base from '../layouts/Base.astro';
import AvailableList from '../components/AvailableList.astro';
import GuiddoPattern from '../components/GuiddoPattern.astro';
import Icon from '../components/Icon.astro';
import { DAY_NAMES, DAY_SLUGS, SLOTS } from '../lib/availability.ts';
import { SPECIALTY_HINTS } from '../data/hints.ts';
import { BRAND, MIN_DOCTORS_FOR_HUB_INDEX } from '../config.ts';
import { doctorCount, doctorsForFacility, getCities, getFacilities, getGuides, getSpecialties, queryHub } from '../lib/data.ts';
import { hubPath } from '../lib/hubs.ts';
import { siteJsonLd } from '../lib/schema.ts';

const specs = getSpecialties().map((s) => ({ s, n: doctorCount(s.id) })).filter((x) => x.n > 0);
// each city links to the hub of its best-represented specialty (always a page that exists)
const cities = getCities().map((c) => {
  const best = getSpecialties().map((sp) => ({ sp, k: queryHub({ specialty: sp, city: c }).length })).sort((a, b) => b.k - a.k)[0];
  return { c, n: doctorCount(undefined, c.id), href: best && best.k > 0 ? hubPath({ specialty: best.sp, city: c }) : null };
}).filter((x) => x.n > 0 && x.href);
const centers = getFacilities().filter((f) => doctorsForFacility(f.id).length > 0).sort((x, y) => x.name.localeCompare(y.name, 'es'));
const SIGN_TONES = ['ink', 'blue', 'pale', 'pale'] as const; // Ink -> Guiddo Blue -> Pale Blue -> Pale Blue, repeating (kit §6.3)
const signs = [...specs].sort((a, b) => b.n - a.n).slice(0, 8);
const guides = getGuides().slice(0, 3);
Astro.response.headers.set('Cache-Control', 'public, s-maxage=60, stale-while-revalidate=300'); // the list shows who is in consultation right now
---
<Base title={`${BRAND} — la guía de doctores dominicanos`} description="Encuentra doctores en República Dominicana: perfiles verificados con exequátur comprobado, clínicas y hospitales, ARS aceptadas y precios de consulta." jsonLd={siteJsonLd()}>
  <section class="hero">
    <GuiddoPattern />
    <div class="wrap">
      <div class="gd-label">La guía de doctores dominicanos</div>
      <h1 class="gd-h1">Encuentra un doctor <span class="accent">disponible hoy</span></h1>
      <!-- Filters update the list below in place (script at the bottom). Without JS the form falls back to GET /buscar (noindex). -->
      <div class="board"><form class="finder" action="/buscar" method="get" data-live data-event="search" aria-label="Filtros">
        <select class="fsel fsel--wide" name="especialidad" aria-label="Especialidad"><option value="">Especialidad</option>{specs.map(({ s }) => <option value={s.slug}>{s.name_singular}</option>)}</select>
        <select class="fsel" name="ciudad" aria-label="Provincia (recomendado)"><option value="">Provincia</option>{cities.map(({ c }) => <option value={c.slug}>{c.name}{c.province !== c.name ? ` · ${c.province}` : ''}</option>)}</select>
        <select class="fsel" name="centro" aria-label="Centro médico"><option value="">Centro médico</option>{centers.map((f) => <option value={f.slug}>{f.name}</option>)}</select>
        <select class="fsel" name="dia" aria-label="Día"><option value="">Hoy</option><option value="manana">Mañana</option>{DAY_SLUGS.map((d, i) => <option value={d}>{DAY_NAMES[i]}</option>)}</select>
        <select class="fsel" name="hora" aria-label="Hora"><option value="ahora">Ahora</option><option value="">Cualquier hora</option>{Object.entries(SLOTS).map(([k, s]) => <option value={k}>{s.label}</option>)}</select>
        <button class="gd-btn" type="submit">Ver resultados</button>
      </form>
      <div id="resultados" class="board__body" aria-live="polite" aria-labelledby="res-titulo"><AvailableList filters={{}} /></div></div>
      <div class="ticks"><span><Icon name="check" size={18} /> Exequátur verificado</span><span><Icon name="check" size={18} /> Información transparente</span></div>
    </div>
  </section>

  <section class="section wrap" aria-labelledby="esp" style="padding-bottom:14px;padding-top:14px">
    <div class="gd-label soft">Especialidades</div>
    <div class="section-head"><h2 class="gd-h2" id="esp">¿Hacia dónde vas?</h2><a class="more" href="/especialidad">Todas las especialidades →</a></div>
    <nav class="gd-signs cols" aria-label="Especialidades">
      {signs.map(({ s, n }, i) => (
        <a class={`gd-sign gd-sign--${SIGN_TONES[i % 4]}`} href={`/${s.slug}`}><span><span class="gd-sign__name">{s.name_singular}</span>{SPECIALTY_HINTS[s.slug] && <span class="gd-sign__hint">{SPECIALTY_HINTS[s.slug]}</span>}</span><span class="gd-mono">→</span></a>
      ))}
    </nav>
  </section>

  <section class="section wrap" style="padding-top:0" aria-labelledby="ciudades">
    <div class="gd-label soft">Ciudades</div>
    <h2 class="gd-h2" id="ciudades" style="margin-bottom:8px">Tu salud, cerca de ti</h2>
    <div class="grid cities">
      {cities.map(({ c, n, href }) => <a class="city-row" href={href!}><Icon name="pin" size={22} /><span><strong>{c.name}</strong></span><Icon name="arrow" size={18} /></a>)}
    </div>
  </section>

  <section class="banner" aria-label="Verificación">
    <div class="wrap"><span class="tile"><Icon name="shield" size={28} /></span><div><h2>Información clara antes de elegir.</h2><p>Los doctores verificados tienen el exequátur comprobado por nosotros. Los perfiles informativos usan datos públicos y lo indican.</p><a class="more" href="/como-verificamos">Cómo verificamos →</a></div></div>
  </section>

  <section class="section wrap" aria-labelledby="guias">
    <div class="gd-label soft">Guías de salud</div>
    <h2 class="gd-h2" id="guias" style="margin-bottom:12px">Un poco de orientación</h2>
    <div class="grid guides">
      {guides.map((g) => <a class="gcard" href={`/guia/${g.slug}`}><span class="art"><Icon name={g.icon} size={40} /></span><span class="body"><span class="eyebrow">{g.category}</span><h3>{g.title}</h3><p>{g.answer_summary.split('. ')[0]}.</p><small>{g.read_minutes} min de lectura · Revisión médica</small></span></a>)}
    </div>
  </section>

  <section class="gd-dark" aria-labelledby="para-doctores">
    <div class="gd-crop" aria-hidden="true">dd</div>
    <div class="wrap">
      <div class="gd-label">Para doctores</div>
      <h2 class="gd-h2" id="para-doctores" style="font-size:26px;line-height:1.02;letter-spacing:-0.6px;margin-top:6px;color:var(--gd-paper)">Haz que los próximos pacientes te encuentren</h2>
      <p style="font-size:14px;font-weight:700;color:var(--gd-blue-pale);margin:6px 0 0;max-width:30rem">Perfil verificado, foto y citas por WhatsApp o en línea, en guiddo.</p>
      <a href="/doctores" class="gd-btn gd-btn--blue" style="margin-top:14px">Únete a guiddo</a>
    </div>
  </section>
  <script is:inline>
    // Tiles open their info box (<dialog>); without JS they are plain links to the profile.
    document.addEventListener('click', function (e) {
      var t = e.target.closest && e.target.closest('[data-open]');
      if (t) { var dlg = document.getElementById(t.getAttribute('data-open')); if (dlg && dlg.showModal) { e.preventDefault(); dlg.showModal(); } return; }
      var c = e.target.closest && e.target.closest('dialog [data-close]');
      if (c) { c.closest('dialog').close(); return; }
      if (e.target.matches && e.target.matches('dialog.gd-modal')) e.target.close(); // click on the backdrop
    });
  </script>
  <script is:inline>
    // Filters re-render the list in place (no page change). Without JS the form still works: it goes to /buscar.
    (function () {
      var f = document.querySelector('[data-live]'), box = document.getElementById('resultados');
      if (!f || !box || !window.fetch) return;
      var btn = f.querySelector('button[type=submit]'); if (btn) btn.hidden = true;
      var seq = 0;
      function load() {
        var n = ++seq;
        box.setAttribute('aria-busy', 'true');
        fetch('/disponibles?' + new URLSearchParams(new FormData(f)))
          .then(function (r) { if (!r.ok) throw new Error(r.status); return r.text(); })
          .then(function (html) { if (n === seq) box.innerHTML = html; })
          .catch(function () { if (n === seq) box.innerHTML = '<p class="panel">No pudimos actualizar la lista. <a href="/especialidad">Ver todos los doctores</a></p>'; })
          .then(function () { if (n === seq) box.removeAttribute('aria-busy'); });
      }
      f.addEventListener('change', load);
      f.addEventListener('submit', function (e) { e.preventDefault(); load(); });
    })();
  </script>
</Base>
