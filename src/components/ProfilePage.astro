---
import Base from '../layouts/Base.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import DoctorCard from './DoctorCard.astro';
import MapBox from './MapBox.astro';
import Icon from './Icon.astro';
import { BRAND } from '../config.ts';
import { doctorMentions, isAffiliated, nearbyDoctors, type DoctorView } from '../lib/data.ts';
import { MENTION_KIND_LABEL, MENTION_ORIGIN_LABEL } from '../lib/mentions.ts';
import { agentNoun, doctorHubLinks, factSummary, initialsOf, isListedOnly, profileMetaDescription, profilePath, profileTitle, titleOf } from '../lib/facts.ts';
import { formatDate, formatFeeRange, formatScheduleLines, joinList, LANGUAGE_NAMES } from '../lib/format.ts';
import { profileIndexDecision } from '../lib/indexing.ts';
import { breadcrumbJsonLd, physicianJsonLd } from '../lib/schema.ts';
import { calLinkOf, canBook, whatsappBookingLink } from '../lib/booking.ts';
import { hubPath } from '../lib/hubs.ts';

interface Props { v: DoctorView }
const { v } = Astro.props;
const d = v.doctor;
const decision = profileIndexDecision(v);
const loc = v.locations[0];
const affiliated = isAffiliated(d);
const showPhoto = affiliated && !!d.photo_url; // photos only for verified affiliates
const nearby = nearbyDoctors(v, 4);
const mentions = doctorMentions(v); // verified doctors only; items are reviewed by a person before they are published
const crumbs = [{ name: 'Inicio', path: '/' }, { name: v.specialty.name_plural, path: hubPath({ specialty: v.specialty }) }];
if (loc) crumbs.push({ name: loc.city.name, path: hubPath({ specialty: v.specialty, city: loc.city }) });
crumbs.push({ name: d.display_name, path: profilePath(v) });
const jsonLd = [physicianJsonLd(v), breadcrumbJsonLd(crumbs)];
const waNumber = d.whatsapp?.replace(/\D/g, '');
const showBooking = canBook(d); // verified affiliates only
const waBooking = showBooking ? whatsappBookingLink(d, profilePath(v)) : null;
const webBooking = showBooking ? d.booking_url : null;
const calLink = calLinkOf(webBooking);
const verified = affiliated ? d.data_verified_at : null;
const contactPhone = d.phone ?? loc?.phone ?? null;
const ext = d.phone ? null : loc?.phone_ext ?? null; // an extension only makes sense on the clinic switchboard
const fullAddress = loc ? `${loc.suite ? loc.suite + ', ' : ''}${loc.address}${loc.sector && !loc.address.toLowerCase().includes(loc.sector.name.toLowerCase()) ? ', ' + loc.sector.name : ''}, ${loc.city.name}` : '';
const initials = initialsOf(d.display_name);
const role = agentNoun(v).charAt(0).toUpperCase() + agentNoun(v).slice(1);
---
<Base title={profileTitle(v, BRAND)} description={profileMetaDescription(v)} robots={decision.robots} jsonLd={jsonLd} canonicalPath={profilePath(v)}>
  <Breadcrumbs items={crumbs} />
  <div class="wrap page-head">
    <div class="profile-head">
      <div class="portrait" aria-hidden={d.photo_url ? undefined : 'true'}>
        {showPhoto ? <img src={d.photo_url!} width="148" height="148" fetchpriority="high" alt={`Foto de ${d.display_name}`} /> : initials}
      </div>
      <div>
    <h1>{[titleOf(v), d.full_legal_name].filter(Boolean).join(' ')}<span class="sr-only">, </span><span class="role">{role}</span></h1>
    <p style="margin:0">
      {affiliated ? <span class="badge"><Icon name="shield" size={16} /> <span>Médico verificado en {BRAND}</span></span> : <span class="badge type">Perfil informativo · no verificado</span>}
      {d.exequatur_verified_at && <span class="badge" style="margin-left:8px"><Icon name="shield" size={16} /> <span>Exequátur verificado el <time datetime={d.exequatur_verified_at}>{formatDate(d.exequatur_verified_at)}</time></span></span>}
      {d.cmd_member && d.cmd_verified_at && <span class="badge" style="margin-left:8px"><span>Miembro del CMD verificado el <time datetime={d.cmd_verified_at}>{formatDate(d.cmd_verified_at)}</time></span></span>}
      {d.claimed && affiliated && <span class="badge" style="margin-left:8px">Confirmado con el médico</span>}
    </p>
    {(waBooking || webBooking) && (
      <div class="head-actions" id="cita">
        {webBooking && <a class="btn" id="book-online" href={webBooking} target="_blank" rel="noopener" data-booking-cal={calLink ?? undefined} data-event="booking_click" data-doctor={d.slug}><Icon name="clock" size={20} /> Reservar en línea</a>}
        {waBooking && <a class="btn wa" href={waBooking} target="_blank" rel="noopener" data-event="whatsapp_booking_click" data-doctor={d.slug}><Icon name="whatsapp" size={20} /> Agendar por WhatsApp</a>}
        <p class="muted">La cita la confirma el consultorio de {d.display_name}.</p>
      </div>
    )}
      </div>
    </div>
    <p class="summary">{factSummary(v)}</p>
  </div>

  <div class="wrap layout sidebar profile-layout">
    <div>
      {d.bio && <section aria-labelledby="sobre"><h2 id="sobre" style="margin-top:1.5em">Sobre {titleOf(v)} {d.display_name.replace(/^Dra?\.\s*/, '')}</h2><p>{d.bio}</p></section>}

      {mentions.length > 0 && (
        <section aria-labelledby="prensa" style="margin-top:1.5em">
          <h2 id="prensa">En los medios y publicaciones</h2>
          <ul style="list-style:none;padding:0;margin:0;display:grid;gap:12px">
            {mentions.map((m) => (
              <li class="panel" style="padding:14px">
                <p class="muted" style="margin:0 0 4px;font-size:.88rem">{MENTION_KIND_LABEL[m.kind]} · {m.source_name}{m.published_on && <> · <time datetime={m.published_on}>{formatDate(m.published_on)}</time></>}</p>
                <p style="margin:0"><a href={m.url} target="_blank" rel="noopener nofollow"><b>{m.title}</b></a></p>
                {m.summary && <p style="margin:6px 0 0"><span class="muted">{MENTION_ORIGIN_LABEL[m.summary_origin!]}:</span> {m.summary_origin === 'excerpt' ? `«${m.summary}»` : m.summary}</p>}
              </li>
            ))}
          </ul>
          <p class="muted" style="margin:8px 0 0;font-size:.85rem">Enlaces a contenido de terceros, revisados por {BRAND} (último control: <time datetime={mentions.map((m) => m.checked_at!).sort().at(-1)}>{formatDate(mentions.map((m) => m.checked_at!).sort().at(-1)!)}</time>). {BRAND} no controla esos sitios.</p>
        </section>
      )}

      {/* Reserved: reviews section (SPEC §12). Intentionally no markup until phase 2 is live. */}

      <section aria-labelledby="mas" style="margin-top:2em">
        <h2 id="mas">Más en el directorio</h2>
        <ul class="linklist">{doctorHubLinks(v).map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
      </section>
    </div>

    <aside class="profile-aside" aria-label="Ficha, contacto y ubicación">
        <section class="panel ficha" aria-labelledby="datos">
            <h2 id="datos" style="font-size:1.3rem">Ficha del profesional</h2>
            <table class="facts">
              <tbody>
                <tr><th scope="row">Especialidad</th><td><a href={hubPath({ specialty: v.specialty })}>{v.specialty.field_name}</a></td></tr>
                {d.subspecialties.length > 0 && <tr><th scope="row">Subespecialidades</th><td>{d.subspecialties.join(', ')}</td></tr>}
                {v.locations.map((l) => (
                  <tr><th scope="row">Consultorio</th><td>
                    {l.facility ? <a href={`/centro/${l.facility.slug}`}>{l.facility.name}</a> : null}{l.facility ? ' — ' : ''}{l.suite ? `${l.suite}, ` : ''}{l.address}, {l.sector && <><a href={hubPath({ specialty: v.specialty, city: l.city, sector: l.sector })}>{l.sector.name}</a>, </>}<a href={hubPath({ specialty: v.specialty, city: l.city })}>{l.city.name}</a>
                  </td></tr>
                ))}
                {loc && loc.schedule.length > 0 && <tr><th scope="row">Horario</th><td>{formatScheduleLines(loc.schedule).map((line) => <div>{line}</div>)}</td></tr>}
                {v.ars.length > 0 && <tr><th scope="row">ARS que acepta</th><td>{v.ars.map((a, i) => <>{i > 0 && ', '}{a.name}</>)}</td></tr>}
                {formatFeeRange(d.consultation_fee_min, d.consultation_fee_max) && <tr><th scope="row">Precio de consulta</th><td>{formatFeeRange(d.consultation_fee_min, d.consultation_fee_max)}</td></tr>}
                {d.languages.length > 0 && <tr><th scope="row">Idiomas</th><td>{joinList(d.languages.map((l) => LANGUAGE_NAMES[l] ?? l))}</td></tr>}
                {v.locations.some((l) => l.facility) && <tr><th scope="row">Clínicas y hospitales</th><td>{joinList(v.locations.filter((l) => l.facility).map((l) => l.facility!.name))}</td></tr>}
                {d.education.length > 0 && <tr><th scope="row">Formación</th><td>{d.education.join('; ')}</td></tr>}
                {d.accepting_new_patients != null && <tr><th scope="row">Acepta nuevos pacientes</th><td>{d.accepting_new_patients ? 'Sí' : 'No por ahora'}</td></tr>}
              </tbody>
            </table>
          </section>
      <div class="panel contact">
        <h2 style="font-size:1.3rem">{waNumber || contactPhone || d.website ? 'Contacto' : 'Ubicación'}</h2>
        {waNumber && !waBooking && <a class="btn wa" href={`https://wa.me/${waNumber}`} data-event="whatsapp_click" data-doctor={d.slug} rel="noopener"><Icon name="whatsapp" size={20} /> Escribir por WhatsApp</a>}
        {contactPhone && <a class="btn ghost" href={`tel:${contactPhone.replace(/[^+\d]/g, '')}${ext ? `,${ext.replace(/\D/g, '')}` : ''}`} data-event="phone_click" data-doctor={d.slug}><Icon name="phone" size={20} /> {contactPhone}{ext ? ` ext. ${ext}` : ''}</a>}
        {!d.phone && contactPhone && loc?.facility && <p class="muted" style="margin:0;font-size:.9rem">Central de {loc.facility.name}</p>}
        {d.website && <a class="btn ghost" href={d.website} data-event="website_click" data-doctor={d.slug} rel="noopener nofollow">Sitio web</a>}
        {loc && <MapBox lat={loc.lat} lng={loc.lng} address={fullAddress} slug={d.slug} />}
        {loc && <p class="muted" style="margin:0">{fullAddress}</p>}
      </div>
    </aside>
  </div>

  {nearby.length > 0 && (
    <section class="wrap section" aria-labelledby="cercanos">
      <h2 id="cercanos">Otros {v.specialty.name_plural.toLowerCase()} {loc ? `en ${loc.city.name}` : ''}</h2>
      <div class="grid cards">{nearby.map((n) => <DoctorCard v={n} />)}</div>
    </section>
  )}

  <div class="wrap" style="padding-bottom:32px">
    {verified && <p class="muted">Datos verificados el <time datetime={verified}>{formatDate(verified)}</time>. <a href="/como-verificamos">Cómo verificamos</a>.</p>}
    {!affiliated && (
      <div class="panel" style="margin-top:16px;max-width:46rem">
        <p style="margin:0 0 6px"><b>Perfil informativo.</b> Estos datos provienen de fuentes públicas{d.source_name ? <> ({d.source_url ? <a href={d.source_url} rel="noopener nofollow">{d.source_name}</a> : d.source_name})</> : ''}{d.source_retrieved_at ? <>, consultadas el <time datetime={d.source_retrieved_at}>{formatDate(d.source_retrieved_at)}</time></> : ''}, y no han sido verificados por {BRAND}. Pueden estar desactualizados.</p>
        <p style="margin:0">¿Eres este médico? <a href="/contacto">Solicita verificación, corrección o retiro de tu perfil</a>.</p>
      </div>
    )}
  </div>
  {calLink && (
    <script is:inline>
      // Cal.com popup: the third-party script loads only when the visitor shows intent (hover, focus, touch). Without JS, or if it fails, the link opens the booking page in a new tab.
      (function () {
        var a = document.getElementById('book-online'); if (!a) return;
        var calLink = a.getAttribute("data-booking-cal"); if (!calLink) return;
        var started = false;
        function load() {
          if (started) return; started = true;
          (function (C, A, L) { var p = function (a, ar) { a.q.push(ar); }; var d = C.document; C.Cal = C.Cal || function () { var cal = C.Cal; var ar = arguments; if (!cal.loaded) { cal.ns = {}; cal.q = cal.q || []; d.head.appendChild(d.createElement('script')).src = A; cal.loaded = true; } if (ar[0] === L) { var api = function () { p(api, arguments); }; var namespace = ar[1]; api.q = api.q || []; if (typeof namespace === 'string') { cal.ns[namespace] = cal.ns[namespace] || api; p(cal.ns[namespace], ar); p(cal, ['initNamespace', namespace]); } else p(cal, ar); return; } p(cal, ar); }; })(window, 'https://app.cal.com/embed/embed.js', 'init');
          window.Cal('init', { origin: 'https://app.cal.com' });
        }
        ['pointerenter', 'focus', 'touchstart'].forEach(function (ev) { a.addEventListener(ev, load, { once: true, passive: true }); });
        a.addEventListener('click', function (e) {
          load();
          e.preventDefault();
          window.Cal('modal', { calLink: calLink, config: { layout: 'month_view', theme: 'light' } });
          // if the popup never shows up (blocked script, offline), fall back to the plain page
          setTimeout(function () { if (!document.querySelector('cal-modal-box')) window.open(a.href, '_blank', 'noopener'); }, 8000);
        });
      })();
    </script>
  )}
</Base>
