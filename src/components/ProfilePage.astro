---
import Base from '../layouts/Base.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import DoctorCard from './DoctorCard.astro';
import Icon from './Icon.astro';
import { BRAND } from '../config.ts';
import { nearbyDoctors, type DoctorView } from '../lib/data.ts';
import { agentNoun, doctorHubLinks, factSummary, profileMetaDescription, profilePath, profileTitle, titleOf } from '../lib/facts.ts';
import { formatDate, formatFeeRange, formatScheduleLines, joinList, LANGUAGE_NAMES } from '../lib/format.ts';
import { profileIndexDecision } from '../lib/indexing.ts';
import { breadcrumbJsonLd, physicianJsonLd } from '../lib/schema.ts';
import { hubPath } from '../lib/hubs.ts';

interface Props { v: DoctorView }
const { v } = Astro.props;
const d = v.doctor;
const decision = profileIndexDecision(v);
const loc = v.locations[0];
const nearby = nearbyDoctors(v, 4);
const crumbs = [{ name: 'Inicio', path: '/' }, { name: v.specialty.name_plural, path: hubPath({ specialty: v.specialty }) }];
if (loc) crumbs.push({ name: loc.city.name, path: hubPath({ specialty: v.specialty, city: loc.city }) });
crumbs.push({ name: d.display_name, path: profilePath(v) });
const jsonLd = [physicianJsonLd(v), breadcrumbJsonLd(crumbs)];
const waNumber = d.whatsapp?.replace(/\D/g, '');
const mapQuery = loc?.lat != null && loc.lng != null ? { lat: loc.lat, lng: loc.lng } : null;
const mapSrc = mapQuery ? `https://www.openstreetmap.org/export/embed.html?bbox=${mapQuery.lng - 0.004},${mapQuery.lat - 0.0025},${mapQuery.lng + 0.004},${mapQuery.lat + 0.0025}&layer=mapnik&marker=${mapQuery.lat},${mapQuery.lng}` : null;
const verified = d.data_verified_at;
---
<Base title={profileTitle(v, BRAND)} description={profileMetaDescription(v)} robots={decision.robots} jsonLd={jsonLd} canonicalPath={profilePath(v)}>
  <Breadcrumbs items={crumbs} />
  <div class="wrap page-head">
    <h1>{titleOf(v)} {d.full_legal_name}, {agentNoun(v)}</h1>
    <p>
      {d.exequatur_verified_at && <span class="badge"><Icon name="shield" size={16} /> Exequátur verificado el <time datetime={d.exequatur_verified_at}>{formatDate(d.exequatur_verified_at)}</time></span>}
      {d.cmd_member && d.cmd_verified_at && <span class="badge" style="margin-left:8px">Miembro del CMD verificado el <time datetime={d.cmd_verified_at}>{formatDate(d.cmd_verified_at)}</time></span>}
      {d.claimed && <span class="badge" style="margin-left:8px">Perfil reclamado por el profesional</span>}
    </p>
    <p class="summary">{factSummary(v)}</p>
  </div>

  <div class="wrap layout sidebar">
    <div>
      <section aria-labelledby="datos">
        <h2 id="datos">Datos del profesional</h2>
        <table class="facts">
          <tbody>
            <tr><th scope="row">Especialidad</th><td><a href={hubPath({ specialty: v.specialty })}>{v.specialty.field_name}</a></td></tr>
            {d.subspecialties.length > 0 && <tr><th scope="row">Subespecialidades</th><td>{d.subspecialties.join(', ')}</td></tr>}
            {v.locations.map((l) => (
              <tr><th scope="row">Consultorio</th><td>
                {l.facility ? <a href={`/centro/${l.facility.slug}`}>{l.facility.name}</a> : null}{l.facility ? ' — ' : ''}{l.address}, <a href={hubPath({ specialty: v.specialty, city: l.city, sector: l.sector })}>{l.sector.name}</a>, <a href={hubPath({ specialty: v.specialty, city: l.city })}>{l.city.name}</a>
              </td></tr>
            ))}
            {loc && loc.schedule.length > 0 && <tr><th scope="row">Horario</th><td>{formatScheduleLines(loc.schedule).map((line) => <div>{line}</div>)}</td></tr>}
            {v.ars.length > 0 && <tr><th scope="row">ARS que acepta</th><td>{v.ars.map((a, i) => <>{i > 0 && ', '}{a.name}</>)}</td></tr>}
            {formatFeeRange(d.consultation_fee_min, d.consultation_fee_max) && <tr><th scope="row">Precio de consulta</th><td>{formatFeeRange(d.consultation_fee_min, d.consultation_fee_max)}</td></tr>}
            {d.languages.length > 0 && <tr><th scope="row">Idiomas</th><td>{joinList(d.languages.map((l) => LANGUAGE_NAMES[l] ?? l))}</td></tr>}
            {v.locations.some((l) => l.facility) && <tr><th scope="row">Clínicas y hospitales</th><td>{joinList(v.locations.filter((l) => l.facility).map((l) => l.facility!.name))}</td></tr>}
            {d.education.length > 0 && <tr><th scope="row">Formación</th><td>{d.education.join('; ')}</td></tr>}
            {d.accepting_new_patients != null && <tr><th scope="row">Acepta nuevos pacientes</th><td>{d.accepting_new_patients ? 'Sí' : 'No por ahora'}</td></tr>}
          </tbody>
        </table>
      </section>

      {d.bio && <section aria-labelledby="sobre"><h2 id="sobre" style="margin-top:1.5em">Sobre {titleOf(v)} {d.display_name.replace(/^Dra?\.\s*/, '')}</h2><p>{d.bio}</p></section>}

      {/* Reserved: reviews section (SPEC §12). Intentionally no markup until phase 2 is live. */}

      <section aria-labelledby="mas" style="margin-top:2em">
        <h2 id="mas">Más en el directorio</h2>
        <ul class="linklist">{doctorHubLinks(v).map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
      </section>
    </div>

    <aside aria-label="Contacto y ubicación">
      <div class="panel contact">
        <h2 style="font-size:1.3rem">Contacto</h2>
        {waNumber && <a class="btn wa" href={`https://wa.me/${waNumber}`} data-event="whatsapp_click" data-doctor={d.slug} rel="noopener"><Icon name="whatsapp" size={20} /> Escribir por WhatsApp</a>}
        {d.phone && <a class="btn ghost" href={`tel:${d.phone.replace(/[^+\d]/g, '')}`} data-event="phone_click" data-doctor={d.slug}><Icon name="phone" size={20} /> {d.phone}</a>}
        {d.website && <a class="btn ghost" href={d.website} data-event="website_click" data-doctor={d.slug} rel="noopener nofollow">Sitio web</a>}
        {loc && (
          <div class="map" id="map-box">
            <img src="/img/map-placeholder.svg" width="640" height="320" loading="lazy" alt={`Mapa: ${loc.address}, ${loc.sector.name}, ${loc.city.name}`} />
            {mapSrc && <button type="button" class="btn ghost" id="map-open" data-event="map_open" data-doctor={d.slug} data-src={mapSrc}>Ver mapa interactivo</button>}
          </div>
        )}
        {loc && <p class="muted" style="margin:0">{loc.address}, {loc.sector.name}, {loc.city.name}</p>}
      </div>
    </aside>
  </div>

  {nearby.length > 0 && (
    <section class="wrap section" aria-labelledby="cercanos">
      <h2 id="cercanos">Otros {v.specialty.name_plural.toLowerCase()} {loc ? `en ${loc.city.name}` : ''}</h2>
      <div class="grid cards">{nearby.map((n) => <DoctorCard v={n} />)}</div>
    </section>
  )}

  <div class="wrap" style="padding-bottom:32px">
    {verified && <p class="muted">Datos verificados el <time datetime={verified}>{formatDate(verified)}</time>. <a href="/como-verificamos">Cómo verificamos</a>.</p>}
  </div>
  <script is:inline>
    // Interactive map loads only on click (SPEC §9). Everything above works without JS.
    var b = document.getElementById('map-open');
    if (b) b.addEventListener('click', function () {
      var f = document.createElement('iframe'); f.src = b.getAttribute('data-src'); f.title = 'Mapa'; f.loading = 'lazy';
      var box = document.getElementById('map-box'); box.innerHTML = ''; box.appendChild(f);
    });
  </script>
</Base>
