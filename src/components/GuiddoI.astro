---
// The guiddo "i" (stem + dot), tilted: stands in for a doctor's photo when there is none. Decorative (the name is next to it).
interface Props { size?: number }
const { size = 64 } = Astro.props;
---
<svg class="gd-i" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64" width={size} height={size} aria-hidden="true" focusable="false">
  <g transform="rotate(14 32 36)"><rect x="22" y="28" width="20" height="28" rx="10" fill="var(--gd-blue)" /><circle cx="32" cy="16" r="9" fill="var(--gd-ink)" /></g>
</svg>
