---
// The board: doctor + specialty + hour rows for the current moment (or the chosen filters). Used by the home hero and by
// /disponibles, the fragment the home filters fetch so results change in place.
import DoctorSlot from './DoctorSlot.astro';
import { availableDoctors, type AvailFilters } from '../lib/available.ts';
import { hubPath } from '../lib/hubs.ts';
import { getCityBySlug, getSpecialtyBySlug } from '../lib/data.ts';
interface Props { filters: AvailFilters }
const a = availableDoctors(Astro.props.filters);
const spec = a.specialty ? getSpecialtyBySlug(a.specialty) : null;
const city = Astro.props.filters.ciudad ? getCityBySlug(Astro.props.filters.ciudad) : null;
const seeAll = spec ? hubPath({ specialty: spec, city: city ?? undefined }) : '/especialidad';
---
<div class="board__head"><h2 id="res-titulo">{a.heading}</h2><span class="gd-label soft">Horario publicado de cada perfil</span></div>
{a.items.length > 0 && <ul class="board__list">{a.items.map((u) => <DoctorSlot u={u} day={a.day} />)}</ul>}
{a.items.length === 0 && <p class="board__empty">Prueba con otro día u hora, o <a href={seeAll}>mira todos los doctores{spec ? ` de ${spec.name_singular}` : ''}</a>.</p>}
<p class="board__foot">No es una cita confirmada: confirma siempre con el consultorio. <a href={seeAll}>Ver todos {spec ? `los ${spec.name_plural.toLowerCase()}` : 'los doctores'} →</a></p>
