---
interface Props { items: { name: string; path: string }[] }
const { items } = Astro.props;
---
<nav class="crumbs wrap" aria-label="Migas de pan">
  <ol>
    {items.map((it, i) => <li>{i === items.length - 1 ? <span aria-current="page">{it.name}</span> : <a href={it.path}>{it.name}</a>}</li>)}
  </ol>
</nav>
