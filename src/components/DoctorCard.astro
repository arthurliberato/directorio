---
import Icon from './Icon.astro';
import { isAffiliated, type DoctorView } from '../lib/data.ts';
import { agentNoun, initialsOf, profilePath } from '../lib/facts.ts';
import { formatDOP } from '../lib/format.ts';
interface Props { v: DoctorView; heading?: 'h2' | 'h3' }
const { v, heading = 'h3' } = Astro.props;
const H = heading;
const d = v.doctor; const loc = v.locations[0];
const initials = initialsOf(d.display_name);
const affiliated = isAffiliated(d);
const showPhoto = affiliated && !!d.photo_url; // photos are a verified-affiliate benefit
const arsText = v.ars.length ? `${v.ars[0].name}${v.ars.length > 1 ? ' y otras ARS' : ''}` : null;
---
<article class:list={['dcard', { sponsored: d.sponsored }]}>
  <div class="top">
    <div class="avatar" aria-hidden="true">{showPhoto ? <img src={d.photo_url!} alt="" width="80" height="88" loading="lazy" /> : initials}</div>
    <div>
      {d.sponsored && <div class="tag-sponsor">Patrocinado</div>}
      <H><a href={profilePath(v)}>{d.display_name}</a></H>
      <div class="spec">{v.specialty.field_name}</div>
      {affiliated ? <span class="badge"><Icon name="shield" size={16} /> Médico verificado</span> : <span class="badge type">Perfil informativo</span>}
    </div>
  </div>
  <ul class="meta">
    {loc && <li><Icon name="pin" size={20} /> {loc.sector ? `${loc.sector.name}, ` : ''}{loc.city.name}</li>}
    {arsText && <li><Icon name="shield" size={20} /> {arsText}</li>}
    {loc?.facility && <li><Icon name="building" size={20} /> {loc.facility.name}</li>}
  </ul>
  <div class="foot">
    <div>{d.consultation_fee_min != null && <><small>Consulta desde</small><strong>{formatDOP(d.consultation_fee_min)}</strong></>}</div>
    <a class="btn ghost" href={profilePath(v)} rel={undefined} aria-label={`Ver perfil de ${d.display_name}, ${agentNoun(v)}`}>Ver perfil <Icon name="external" size={16} /></a>
  </div>
</article>
