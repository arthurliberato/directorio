---
// The "i" pattern (design kit §6.1): little people (stem + dot) in a staggered grid; one in seven highlighted. Decorative.
interface Props { cols?: number; rows?: number; base?: string; hiBody?: string; hiHead?: string; class?: string }
const { cols = 5, rows = 4, base = 'var(--gd-blue-pattern)', hiBody = 'var(--gd-blue)', hiHead = 'var(--gd-ink)', class: cls = '' } = Astro.props;
const figs = [];
for (let r = 0; r < rows; r++) for (let c = 0; c < cols; c++) figs.push({ x: 14 + c * 32 + (r % 2) * 16, y: 6 + r * 28, hi: (r * cols + c) % 7 === 3 });
---
<svg class:list={['gd-pattern', cls]} viewBox={`0 0 ${cols * 32} ${rows * 28 + 8}`} aria-hidden="true" focusable="false">
  {figs.map((f) => <><rect x={f.x - 4} y={f.y + 7} width="8" height="15" rx="4" fill={f.hi ? hiBody : base} /><circle cx={f.x} cy={f.y + 1} r="4" fill={f.hi ? hiHead : base} /></>)}
</svg>
