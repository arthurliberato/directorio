---
import { BRAND } from '../config.ts';
// Wordmark: lowercase, Nunito Black, the second "d" in Guiddo Blue (design kit §2). Text, not an image: crawlable and always crisp.
const i = BRAND.lastIndexOf('d');
---
<span class="gd-logo" aria-label={BRAND}>{BRAND.slice(0, i)}<span class="gd-logo__d">d</span>{BRAND.slice(i + 1)}</span>
