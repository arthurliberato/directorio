# Public canonical origin (no trailing slash)
PUBLIC_SITE_URL=https://short.do
# prototype = seed data, whole site noindex + robots Disallow:/ ; production = real rules
SITE_MODE=prototype
# Only set to true once publishing exequatur numbers is legally cleared (SPEC 6.1)
PUBLISH_EXEQUATUR_IDENTIFIER=false
# IndexNow key (file served at /<key>.txt)
INDEXNOW_KEY=

# Postgres/Supabase connection string. Unset => illustrative seed data (read-only).
DATABASE_URL=
# Seconds-level refresh of the in-memory snapshot (ms)
DATASET_TTL_MS=60000
# Internal admin (/admin, /api/*) — HTTP Basic. Admin is disabled (503) without a password.
ADMIN_USER=admin
ADMIN_PASSWORD=
# Optional: webhook that purges the CDN cache after admin writes / revalidate
PURGE_WEBHOOK_URL=
