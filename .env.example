# Public canonical origin (no trailing slash)
PUBLIC_SITE_URL=https://short.do
# prototype = seed data, whole site noindex + robots Disallow:/ ; production = real rules
SITE_MODE=prototype
# Only set to true once publishing exequatur numbers is legally cleared (SPEC 6.1)
PUBLISH_EXEQUATUR_IDENTIFIER=false
# IndexNow key (file served at /<key>.txt)
INDEXNOW_KEY=
