# Server
PORT=8787
NODE_ENV=production

# Catalog (same Postgres as the site, restricted role from db/bot-role.sql)
DATABASE_URL=postgres://guiddo_bot:...@host:5432/postgres
DATASET_TTL_MS=60000

# WhatsApp Cloud API (Meta)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v24.0
WHATSAPP_BOT_NAME=guiddo
# Approved template used to message a doctor who has not written to us in the last 24 h (optional)
WHATSAPP_TEMPLATE_APPT=
WHATSAPP_TEMPLATE_LANG=es

# Site + privacy
PUBLIC_SITE_URL=https://guiddo.net
CEDULA_PEPPER=

# Simulator at /admin/simulator (disabled when ADMIN_PASSWORD is empty)
ADMIN_USER=admin
ADMIN_PASSWORD=
